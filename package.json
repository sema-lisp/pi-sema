{
  "name": "@sema-lang/pi-sema",
  "version": "0.2.0",
  "description": "Self-extending Sema toolkit for the Pi coding agent — MCP bridge, tool forging (the agent builds its own tools), and journaled workflows with live TUI status.",
  "license": "MIT",
  "author": "Helge Sverre",
  "repository": {
    "type": "git",
    "url": "https://github.com/sema-lisp/pi-sema.git"
  },
  "homepage": "https://sema-lang.com",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.79.10",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "sema",
    "lisp",
    "llm"
  ]
}
