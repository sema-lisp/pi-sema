{
  "name": "@sema-lang/pi-sema",
  "version": "0.2.0",
  "description": "Self-extending Sema toolkit for the Pi coding agent — MCP bridge, tool forging (the agent builds its own tools), and journaled workflows with live TUI status.",
  "license": "MIT",
  "author": {
    "name": "Helge Sverre",
    "email": "helge.sverre@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sema-lisp/pi-sema.git"
  },
  "bugs": {
    "url": "https://github.com/sema-lisp/pi-sema/issues"
  },
  "homepage": "https://sema-lang.com",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "themes/",
    "skills/",
    "prompts/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "format": "prettier --write '**/*.{js,ts,md,html}'",
    "format:check": "prettier --check '**/*.{js,ts,md,html}'",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "themes": [
      "./themes/sema.json"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "keywords": [
    "sema",
    "lisp",
    "llm",
    "scheme",
    "s-expression",
    "ai",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@google/genai": true,
    "fsevents": true
  }
}
